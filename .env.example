# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=bd_nexalab
DB_SYNC=true
DB_LOGGING=false

# JWT (cambiar en producción)
JWT_SECRET=change_me_nexalab_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Admin seed (no usar credenciales reales en producción)
ADMIN_EMAIL=admin@nexalab.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Administrador NEXALAB

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
